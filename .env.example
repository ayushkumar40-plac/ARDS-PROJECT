# Twilio credentials for HIGH-risk patient alert notifications
# Set these in your Vercel dashboard → Settings → Environment Variables
# Do NOT commit real credentials to version control

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TWILIO_WHATSAPP_NUMBER=

# Optional: Alert rate limiting (defaults shown)
# ALERT_RATE_LIMIT_PER_WINDOW=5
# ALERT_RATE_LIMIT_WINDOW_MS=900000

# Optional: Restrict which origins can call the alert API
# ALERT_ALLOWED_ORIGIN=https://your-domain.com