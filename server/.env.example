# Twilio credentials (https://console.twilio.com)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token

# Sender identities
# SMS sender must be an SMS-capable Twilio number in E.164 format
TWILIO_SMS_FROM=+14155551234
# WhatsApp sender; the Twilio sandbox number works for testing
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# Service configuration
PORT=8787
# Comma-separated list of allowed browser origins ("*" allows any)
ALLOWED_ORIGINS=*
# When true (or when Twilio credentials are missing) messages are logged, not sent
DRY_RUN=false
# Minutes during which a repeat alert for the same patient/session is suppressed
DEDUPE_WINDOW_MINUTES=15

# Security configuration
JWT_SECRET=your_jwt_secret_key_at_least_32_characters_long
COMMUNITY_PORT=8788
NODE_ENV=production
